# ==========================================
# CONFIGURACIÓN DE ENTORNO - COTTON KNIT
# ==========================================

# 1. Nombre de la red de Docker donde corre Nginx Proxy Manager (ej: npm-network, nginx-proxy, bridge, etc.)
# Para saber el nombre exacto de la red en tu servidor, ejecuta: docker network ls
NPM_NETWORK_NAME=npm-network

# 2. Conexión a Base de Datos MySQL
# Opción A (Recomendada): Usar tu base de datos actual de Clever Cloud
SPRING_DATASOURCE_URL=jdbc:mysql://bxx...-mysql.services.clever-cloud.com:3306/bxx...?useSSL=true
SPRING_DATASOURCE_USERNAME=uxxx...
SPRING_DATASOURCE_PASSWORD=pxxx...

# 3. Modo JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update
